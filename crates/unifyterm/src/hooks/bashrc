# Written by unifyterm each time it starts: changes here are lost.
# bash reads this instead of ~/.bashrc in unifyterm's tabs; it reads
# ~/.bashrc first (on macOS, your profile files: see below).
# `[history] enabled = false` in unifyterm's settings turns it off.
#
# It tells unifyterm, in standard terminal marks, where the prompt starts
# and ends (OSC 133;A and B), when a command starts (133;C), what it was
# and how it ended (633;E, 133;D) and which directory this is (633;P;Cwd).
# Adapted from keepane's shell hooks (MIT, same author).

if [ -n "$UNIFYTERM_LOGIN" ]; then
    # The first shell of a session (macOS, where terminals start login
    # shells): the files a login bash reads, since bash started with
    # --rcfile reads none of them. Shells started from this one are not
    # login shells: the variable does not go on to them.
    unset UNIFYTERM_LOGIN
    if [ -f /etc/profile ]; then . /etc/profile; fi
    for __unifyterm_file in ~/.bash_profile ~/.bash_login ~/.profile; do
        if [ -f "$__unifyterm_file" ]; then
            . "$__unifyterm_file"
            break
        fi
    done
    unset __unifyterm_file
elif [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

# unifyterm's commands first in PATH again: the start files above may have
# put other directories in front (macOS's /etc/profile puts the system's there).
if [ -n "$UNIFYTERM_COMMANDS" ]; then
    __unifyterm_rest=":$PATH:"
    __unifyterm_rest=${__unifyterm_rest//":$UNIFYTERM_COMMANDS:"/:}
    __unifyterm_rest=${__unifyterm_rest#:}
    __unifyterm_rest=${__unifyterm_rest%:}
    PATH="$UNIFYTERM_COMMANDS${__unifyterm_rest:+:$__unifyterm_rest}"
    unset __unifyterm_rest
fi

# A mark's text: \ is written \\, ; is \x3b, a line break \x0a.
__unifyterm_escape() {
    local s=${1//\\/\\\\}
    s=${s//;/\\x3b}
    s=${s//$'\n'/\\x0a}
    printf '%s' "$s"
}

# The history number last reported: a prompt with no new entry reports no command.
__unifyterm_seen=$(HISTTIMEFORMAT= history 1 | sed -n 's/^ *\([0-9]*\).*/\1/p')

__unifyterm_status() {
    local code=$? last number text
    last=$(HISTTIMEFORMAT= history 1)
    number=$(printf '%s' "$last" | sed -n 's/^ *\([0-9]*\).*/\1/p')
    if [ -n "$number" ] && [ "$number" != "$__unifyterm_seen" ]; then
        __unifyterm_seen=$number
        text=$(printf '%s' "$last" | sed 's/^ *[0-9]* *//')
        printf '\e]633;E;%s\e\\\e]133;D;%s\e\\' "$(__unifyterm_escape "$text")" "$code"
    fi
    printf '\e]633;P;Cwd=%s\e\\' "$(__unifyterm_escape "$PWD")"
    return $code
}

# Around the prompt, after whatever else sets PS1 (a theme may set it at each prompt).
__unifyterm_wrap() {
    case "$PS1" in
        *']133;B'*) ;;
        *) PS1="\[$(printf '\033]133;A\007')\]$PS1\[$(printf '\033]133;B\007')\]" ;;
    esac
}

PS0="$(printf '\033]133;C\007')${PS0}"
PROMPT_COMMAND="__unifyterm_status;${PROMPT_COMMAND:+$PROMPT_COMMAND;}__unifyterm_wrap"
printf '\e]633;P;Shell=bash\e\\'
