# Written by uni-term each time it starts: changes here are lost.
# zsh reads this as its .zshrc in uni-term's tabs (uni-term points ZDOTDIR
# here); your own start files are read first, from where they were.
# `[history] enabled = false` in uni-term's settings turns it off.
#
# It tells uni-term, in standard terminal marks, where the prompt starts
# and ends (OSC 133;A and B), when a command starts (133;C), what it was
# and how it ended (633;E, 133;D) and which directory this is (633;P;Cwd).
# Adapted from keepane's shell hooks (MIT, same author).

[[ -f "$UNI_TERM_ZDOTDIR/.zshrc" ]] && ZDOTDIR="$UNI_TERM_ZDOTDIR" source "$UNI_TERM_ZDOTDIR/.zshrc"
# From here on, zsh finds your files where they are.
ZDOTDIR="$UNI_TERM_ZDOTDIR"

__uni_term_escape() {
    local s=${1//\\/\\\\}
    s=${s//;/\\x3b}
    s=${s//$'\n'/\\x0a}
    print -rn -- "$s"
}

__uni_term_running=0

__uni_term_preexec() {
    __uni_term_running=1
    printf '\e]633;E;%s\e\\\e]133;C\e\\' "$(__uni_term_escape "$1")"
}

__uni_term_precmd() {
    local code=$?
    if (( __uni_term_running )); then
        printf '\e]133;D;%s\e\\' "$code"
        __uni_term_running=0
    fi
    printf '\e]633;P;Cwd=%s\e\\' "$(__uni_term_escape "$PWD")"
    case "$PS1" in
        *$'\e]133;B'*) ;;
        *) PS1="%{"$'\e]133;A\a'"%}$PS1%{"$'\e]133;B\a'"%}" ;;
    esac
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec __uni_term_preexec
add-zsh-hook precmd __uni_term_precmd
printf '\e]633;P;Shell=zsh\e\\'
