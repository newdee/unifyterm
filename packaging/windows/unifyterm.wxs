<?xml version="1.0" encoding="utf-8"?>
<!--
  UnifyTerm's Windows installer (WiX v4 or later):

    wix build packaging/windows/unifyterm.wxs -arch x64 -d Version=0.1.0 -d BinDir=target/release -d Root=. -o unifyterm-0.1.0-x64.msi

  It installs into Program Files\unifyterm: unifyterm.exe, ut.exe, the ConPTY
  (conpty.dll and OpenConsole.exe, which unifyterm finds beside itself), the
  license files, a Start menu item and a desktop icon (for every user; not made
  with DESKTOPSHORTCUT=0: msiexec /i unifyterm-VERSION-x64.msi DESKTOPSHORTCUT=0).
  Both are plain shortcuts to unifyterm.exe and show its own icon. Uninstalling removes all of them; the
  user's settings, history and log (in %APPDATA% and %LOCALAPPDATA%) stay.
  The UpgradeCode never changes: a newer version replaces an older one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="UnifyTerm" Manufacturer="newdee" Version="$(var.Version)" UpgradeCode="556C9CAA-40B6-4AB3-8A75-6A57939DE587" Scope="perMachine" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer UnifyTerm is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- For "Apps and features". Its name ends in .ico: Windows reads an icon file by its extension. -->
    <Icon Id="UnifyTerm.ico" SourceFile="$(var.Root)\packaging\icons\unifyterm.ico" />
    <Property Id="ARPPRODUCTICON" Value="UnifyTerm.ico" />
    <Property Id="DESKTOPSHORTCUT" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/newdee/unifyterm" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="unifyterm">
        <Component Id="UnifyTerm">
          <File Id="UnifyTermExe" Source="$(var.BinDir)\unifyterm.exe" KeyPath="yes">
            <!-- Not advertised: an advertised shortcut leads to a copy of the icon in Windows Installer's
                 cache, a file without an extension, which some of Windows draws as a blank page. -->
            <Shortcut Id="StartMenuUnifyTerm" Directory="ProgramMenuFolder" Name="UnifyTerm" Description="One terminal for Windows, macOS and Linux" WorkingDirectory="INSTALLFOLDER" />
          </File>
        </Component>
        <Component Id="Ut">
          <File Id="UtExe" Source="$(var.BinDir)\ut.exe" KeyPath="yes" />
        </Component>
        <!-- One file a component: WiX makes each one's GUID from its path. -->
        <Component Id="ConPty">
          <File Id="ConPtyDll" Source="$(var.BinDir)\conpty.dll" KeyPath="yes" />
        </Component>
        <Component Id="OpenConsole">
          <File Id="OpenConsoleExe" Source="$(var.BinDir)\OpenConsole.exe" KeyPath="yes" />
        </Component>
        <Component Id="License">
          <File Id="License" Source="$(var.Root)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
        </Component>
        <Component Id="Notices">
          <File Id="Notices" Source="$(var.Root)\THIRD-PARTY-NOTICES" Name="THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopUnifyTerm" Name="UnifyTerm" Description="One terminal for Windows, macOS and Linux" Target="[#UnifyTermExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\unifyterm" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="UnifyTerm">
      <ComponentRef Id="UnifyTerm" />
      <ComponentRef Id="Ut" />
      <ComponentRef Id="ConPty" />
      <ComponentRef Id="OpenConsole" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Notices" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>
