<?xml version="1.0" encoding="utf-8"?>
<!--
  uni-term's Windows installer (WiX v4 or later):

    wix build packaging/windows/uni-term.wxs -arch x64 -d Version=0.1.0 -d BinDir=target/release -d Root=. -o uni-term-0.1.0-x64.msi

  It installs into Program Files\uni-term: uni-term.exe, ut.exe, the ConPTY
  (conpty.dll and OpenConsole.exe, which uni-term finds beside itself), the
  license files, and a Start menu item. Uninstalling removes all of them; the
  user's settings, history and log (in %APPDATA% and %LOCALAPPDATA%) stay.
  The UpgradeCode never changes: a newer version replaces an older one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="uni-term" Manufacturer="uni-term" Version="$(var.Version)" UpgradeCode="556C9CAA-40B6-4AB3-8A75-6A57939DE587" Scope="perMachine" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer uni-term is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="UniTermIcon" SourceFile="$(var.Root)\packaging\icons\uni-term.ico" />
    <Property Id="ARPPRODUCTICON" Value="UniTermIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OWNER/uni-term" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="uni-term">
        <Component Id="UniTerm">
          <File Id="UniTermExe" Source="$(var.BinDir)\uni-term.exe" KeyPath="yes">
            <Shortcut Id="StartMenuUniTerm" Directory="ProgramMenuFolder" Name="uni-term" Description="One terminal for Windows, macOS and Linux" WorkingDirectory="INSTALLFOLDER" Icon="UniTermIcon" Advertise="yes" />
          </File>
        </Component>
        <Component Id="Ut">
          <File Id="UtExe" Source="$(var.BinDir)\ut.exe" KeyPath="yes" />
        </Component>
        <Component Id="ConPty">
          <File Id="ConPtyDll" Source="$(var.BinDir)\conpty.dll" KeyPath="yes" />
          <File Id="OpenConsoleExe" Source="$(var.BinDir)\OpenConsole.exe" />
        </Component>
        <Component Id="Licenses">
          <File Id="License" Source="$(var.Root)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
          <File Id="Notices" Source="$(var.Root)\THIRD-PARTY-NOTICES" Name="THIRD-PARTY-NOTICES.txt" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="uni-term">
      <ComponentRef Id="UniTerm" />
      <ComponentRef Id="Ut" />
      <ComponentRef Id="ConPty" />
      <ComponentRef Id="Licenses" />
    </Feature>
  </Package>
</Wix>
